dsl v7
strategy "Opening Range Breakout FX 15m" {
  description "Research-only FX transfer probe for opening-range breakout continuation on liquid 15m pairs."
}

market conditions {
  slices(EURUSD 15m, GBPUSD 15m, AUDUSD 15m)
  sessions(london, ny)
  day type in (trending, ranging, choppy)
}

setup {
  type: opening range breakout
  opening range first 4 candles in (london, ny)
  break beyond range edge by 0.05 ATR
  hold 1 candle
  retest range edge within 4 candles
}

filters {
  higher timeframe must agree
}

risk {
  stop opposite range edge 0.2 ATR
  stop size <= 2.5 ATR
}

target {
  target 1R
}

management {
  move stop to breakeven after 0.75R plus 0.05 ATR
  maxHoldCandles 16
  wait 12 candles after trade
}

execution {
  risk: 200 USD
}