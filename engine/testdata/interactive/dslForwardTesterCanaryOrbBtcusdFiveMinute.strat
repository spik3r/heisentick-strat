dsl v7
strategy "Forward Tester Weekend Canary — BTCUSD 5m 3h ORB" {
  description "Operational canary only. Uses closed BTCUSD five-minute bars in fixed three-hour UTC windows with ATR-based brackets so broker-specific pip assumptions cannot affect the route."
}

market conditions {
  slices(BTCUSD 5m)
  trade window unrestricted
  day type in (trending, ranging, choppy)
  trendiness below 999
}

setup {
  type: opening range breakout
  opening range every 3 hours UTC
  break beyond range edge
  hold 1 candle
}

filters {
  side both
}

risk {
  stop ATR 1.5
  stop size <= 3 ATR
}

target {
  target 2R
}

management {
  move stop to breakeven after 999R plus 0 ATR
}

execution {
  risk: 200 USD
}
