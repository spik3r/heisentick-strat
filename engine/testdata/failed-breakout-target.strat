# Invented range/wick fixture. Numeric target is the fallback, not a fixed override.
dsl v7
strategy "Synthetic Failed Breakout target regression" {}
market conditions {
 timeframes(15m)
 sessions(asia, london, ny)
 day type in (trending, ranging, choppy)
}
levels {
 priority()
}
filters {
 range method zone
 range active within 8 candles
}
setup {
 type failed breakout
}
triggers {
 candle in (pin, engulf, outside)
}
entry {
 when price sweeps range.high by 0.1 within 3 then signal short grade A
 when price sweeps range.low by 0.1 within 3 then signal long grade A
}
risk {
 stop beyond last 3 candle extreme by 0.25 ATR
 stop size max 30
}
target {
 target 2R
 minimum reward 0.6R
}
management {
 move stop to breakeven after 0R plus 0 ATR
 wait 3 candles after trade
}
execution {
 risk 200 USD
}
