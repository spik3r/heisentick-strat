{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequential-backtest-result-v1.schema.json",
  "title": "Sequential synthetic Go companion result v1",
  "description": "Raw binary64 companion metrics; unchanged retained 15-digit trade envelope. Equality/alignment and numerical refusal constraints are additionally enforced at runtime.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "strat-sequential-backtest-result-v1"
        },
        "contractVersion": {
          "const": 1
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategyId": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "timeframe": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "fixtureSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dslSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "barCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500000
            },
            "firstBarMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lastBarMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "costs": {
              "$ref": "run-fixture-v1.schema.json#/$defs/costs"
            },
            "policy": {
              "enum": [
                "E1",
                "E2"
              ]
            }
          },
          "required": [
            "strategyId",
            "symbol",
            "timeframe",
            "profile",
            "fixtureSha256",
            "dslSha256",
            "barCount",
            "firstBarMs",
            "lastBarMs",
            "costs"
          ]
        },
        "run": {
          "$ref": "trade-envelope-v1.schema.json"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "const": "sequential-broker-close-mtm-v1"
            },
            "headline": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "startEquity": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "endEquity": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "net": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "returnPct": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "worstLoss": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "maxDD": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "maxDDpct": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "trades": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxWinStreak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxLossStreak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "winRate": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "profitFactor": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expectancy": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgWin": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgLoss": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgHoldBars": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "winRateReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "profitFactorReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "expectancyReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "avgWinReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "avgLossReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "avgHoldBarsReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                }
              },
              "required": [
                "startEquity",
                "endEquity",
                "net",
                "returnPct",
                "worstLoss",
                "maxDD",
                "maxDDpct",
                "trades",
                "maxWinStreak",
                "maxLossStreak",
                "winRate",
                "profitFactor",
                "expectancy",
                "avgWin",
                "avgLoss",
                "avgHoldBars"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "winRate": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "winRateReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "winRateReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "profitFactor": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "profitFactorReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "profitFactorReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "expectancy": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "expectancyReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "expectancyReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "avgWin": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "avgWinReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "avgWinReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "avgLoss": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "avgLossReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "avgLossReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "avgHoldBars": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "avgHoldBarsReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "avgHoldBarsReason"
                      ]
                    }
                  }
                }
              ]
            },
            "tradeAccounting": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "entryFee": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  },
                  "exitFee": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  },
                  "netPnl": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  }
                },
                "required": [
                  "index",
                  "entryFee",
                  "exitFee",
                  "netPnl"
                ]
              }
            },
            "equity": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "t": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "equity": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  }
                },
                "required": [
                  "index",
                  "t",
                  "equity"
                ]
              }
            }
          },
          "required": [
            "basis",
            "headline",
            "tradeAccounting",
            "equity"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headline": {
              "const": true
            },
            "trades": {
              "const": true
            },
            "equity": {
              "const": true
            },
            "groupings": {
              "const": false
            },
            "monthly": {
              "const": false
            },
            "rDistribution": {
              "const": false
            },
            "portfolio": {
              "const": false
            }
          },
          "required": [
            "headline",
            "trades",
            "equity",
            "groupings",
            "monthly",
            "rDistribution",
            "portfolio"
          ]
        }
      },
      "required": [
        "schema",
        "contractVersion",
        "identity",
        "run",
        "metrics",
        "capabilities"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "strat-sequential-backtest-result-v1"
        },
        "contractVersion": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "barIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "opportunityId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "schema",
        "contractVersion",
        "error"
      ]
    }
  ]
}
