{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic-v1.schema.json",
  "title": "Strat diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["severity", "message", "line", "col"],
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["error", "warning"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "col": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "suggestion": {
      "type": "string",
      "minLength": 1
    }
  }
}
