{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequential-full-execution-v1.schema.json",
  "title": "Synthetic Sequential E1/E2 execution audit v1",
  "description": "Closed completed-run audit. Pending prefix state and incomplete terminal exposure are not public capabilities. Existing trade serialization is separate from these raw finite audit numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "policy",
    "symbol",
    "timeframe",
    "opportunities"
  ],
  "properties": {
    "schema": {
      "const": "sequential-full-execution.v1"
    },
    "profile": {
      "const": "seq.full.public_approx.v1"
    },
    "policy": {
      "enum": [
        "E1",
        "E2"
      ]
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ]
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    }
  },
  "$defs": {
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "episodeId",
        "trigger",
        "side",
        "status",
        "stop",
        "signalAtr",
        "capBinds",
        "setupIndex",
        "setupFirstIndex",
        "decisionIndex",
        "decisionOpenMs",
        "decisionMs",
        "nextOpenIndex"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "episodeId": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "enum": [
            "perf",
            "cd13"
          ]
        },
        "side": {
          "enum": [
            "long",
            "short"
          ]
        },
        "status": {
          "enum": [
            "rejected",
            "filled"
          ]
        },
        "reason": {
          "enum": [
            "warmup",
            "signal_expired",
            "blocked_in_position",
            "simultaneous_signal",
            "no_next_bar",
            "stop_breached_at_entry"
          ]
        },
        "stop": {
          "type": "number"
        },
        "signalAtr": {
          "type": "number",
          "minimum": 0
        },
        "capBinds": {
          "type": "boolean"
        },
        "setupIndex": {
          "type": "integer",
          "minimum": 0
        },
        "setupFirstIndex": {
          "type": "integer",
          "minimum": 0
        },
        "decisionIndex": {
          "type": "integer",
          "minimum": 0
        },
        "decisionOpenMs": {
          "type": "integer",
          "minimum": 0
        },
        "decisionMs": {
          "type": "integer",
          "minimum": 0
        },
        "nextOpenIndex": {
          "type": "integer",
          "minimum": 0
        },
        "fillIndex": {
          "type": "integer",
          "minimum": 0
        },
        "fill": {
          "type": "number"
        },
        "target": {
          "type": "number"
        },
        "riskDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
