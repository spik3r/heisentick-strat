{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-envelope-v1.schema.json",
  "title": "Strat trade envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case",
    "strategyId",
    "symbol",
    "timeframe",
    "higherTimeframe",
    "rangeMethod",
    "costs",
    "tradeCount",
    "trades"
  ],
  "properties": {
    "schema": { "const": "dsl-conformance-trades-v1" },
    "case": { "type": "string", "minLength": 1 },
    "strategyId": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "minLength": 1 },
    "higherTimeframe": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "rangeMethod": { "type": "string", "minLength": 1 },
    "costs": { "$ref": "run-fixture-v1.schema.json#/$defs/costs" },
    "tradeCount": { "type": "integer", "minimum": 0 },
    "trades": {
      "type": "array",
      "items": { "$ref": "#/$defs/trade" }
    }
  },
  "$defs": {
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "entryIndex",
        "entryT",
        "exit",
        "exitIndex",
        "exitT",
        "initialSl",
        "initialTp",
        "meta",
        "pnl",
        "points",
        "reason",
        "side",
        "size",
        "sl",
        "tag",
        "tp"
      ],
      "properties": {
        "entry": { "type": "number" },
        "entryIndex": { "type": "integer", "minimum": 0 },
        "entryT": { "type": "number" },
        "exit": { "type": "number" },
        "exitIndex": { "type": "integer", "minimum": 0 },
        "exitT": { "type": "number" },
        "initialSl": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "initialTp": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "meta": { "type": "object", "minProperties": 1 },
        "pnl": { "type": "number" },
        "points": { "type": "number" },
        "reason": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "side": { "type": "string", "enum": ["long", "short"] },
        "size": { "type": "number" },
        "sl": { "anyOf": [{ "type": "null" }, { "type": "number" }] },
        "tag": { "type": "string", "minLength": 1 },
        "tp": { "anyOf": [{ "type": "null" }, { "type": "number" }] }
      }
    }
  }
}
