{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timed-return-calendar-v1.schema.json",
  "title": "Strat timed return calendar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "timezone",
    "referenceSourceSha256",
    "executionSourceSha256",
    "timezoneDataSha256",
    "timezoneData",
    "tradeFromDate",
    "tradeToDateExclusive",
    "sessions",
    "quotedIntervals"
  ],
  "properties": {
    "schema": {
      "const": "timed-return-calendar-v1"
    },
    "timezone": {
      "enum": [
        "UTC",
        "America/New_York"
      ]
    },
    "referenceSourceSha256": {
      "type": "string",
      "minLength": 64
    },
    "executionSourceSha256": {
      "type": "string",
      "minLength": 64
    },
    "timezoneDataSha256": {
      "type": "string",
      "minLength": 64
    },
    "timezoneData": {
      "type": "string",
      "minLength": 1
    },
    "tradeFromDate": {
      "type": "string",
      "minLength": 1
    },
    "tradeToDateExclusive": {
      "type": "string",
      "minLength": 1
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind"
        ],
        "properties": {
          "date": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "full",
              "early",
              "closed"
            ]
          },
          "open": {
            "type": "string",
            "minLength": 1
          },
          "close": {
            "type": "string",
            "minLength": 1
          },
          "previousSessionDate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quotedIntervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromT",
          "toT"
        ],
        "properties": {
          "fromT": {
            "type": "integer",
            "minimum": 1
          },
          "toT": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
