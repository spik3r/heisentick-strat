{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parse-result-v1.schema.json",
  "title": "Strat parse result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case",
    "category",
    "description",
    "source",
    "cfg",
    "errors",
    "warnings",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "dsl-conformance-parse-v1"
    },
    "case": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "cfg": {
      "type": "object",
      "description": "The existing parser config object; its implementation-owned fields are intentionally not widened here."
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "diagnostic-v1.schema.json" }
    }
  }
}
