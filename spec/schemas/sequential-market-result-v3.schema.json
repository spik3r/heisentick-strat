{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sequential-market-result-v3.schema.json",
  "title": "Sequential E1/E2 market companion result v3",
  "description": "Adds an optional hashed closure calendar and open-terminal reporting to v2; v2 is unchanged. headline.net, returnPct and endEquity count completed trades only; equity[], headline.maxDD and maxDDpct and the marked block use close-bar marks that include an open position's unrealized P&L and paid entry fee. terminal.position is open exactly when openTrade is present. Equality, alignment and numerical refusal constraints are additionally enforced at runtime.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "strat-sequential-market-result-v3"
        },
        "contractVersion": {
          "const": 3
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixtureSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dslSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "strategyId": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "symbol": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_.-]{0,31}$"
                },
                "timeframe": {
                  "enum": [
                    "1m",
                    "5m",
                    "15m",
                    "30m",
                    "1h",
                    "4h",
                    "1d"
                  ]
                },
                "timeframeMs": {
                  "enum": [
                    60000,
                    300000,
                    900000,
                    1800000,
                    3600000,
                    14400000,
                    86400000
                  ]
                },
                "profile": {
                  "const": "seq.full.public_approx.v1"
                },
                "policy": {
                  "enum": [
                    "E1",
                    "E2"
                  ]
                },
                "riskUsd": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "maxNotionalUsd": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                }
              },
              "required": [
                "symbol",
                "timeframe",
                "timeframeMs",
                "profile",
                "policy",
                "riskUsd",
                "maxNotionalUsd"
              ]
            },
            "barCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500000
            },
            "firstBarMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lastBarMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "costs": {
              "$ref": "run-fixture-v1.schema.json#/$defs/costs"
            },
            "calendar": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "calendarId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "provider": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "symbol": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_.-]{0,31}$"
                },
                "timeframe": {
                  "enum": [
                    "1m",
                    "5m",
                    "15m",
                    "30m",
                    "1h",
                    "4h",
                    "1d"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "declaredClosures": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "appliedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "applied": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "closureIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "beforeIndex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "startMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "endMs": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "missingBars": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "closureIndex",
                      "beforeIndex",
                      "startMs",
                      "endMs",
                      "missingBars"
                    ]
                  }
                },
                "appliedTruncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "calendarId",
                "provider",
                "symbol",
                "timeframe",
                "version",
                "sha256",
                "declaredClosures",
                "appliedCount",
                "applied",
                "appliedTruncated"
              ]
            }
          },
          "required": [
            "fixtureSha256",
            "dslSha256",
            "strategyId",
            "route",
            "barCount",
            "firstBarMs",
            "lastBarMs",
            "costs"
          ]
        },
        "run": {
          "$ref": "trade-envelope-v1.schema.json"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "const": "sequential-broker-close-mtm-v1"
            },
            "headline": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "startEquity": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "endEquity": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "net": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "returnPct": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "worstLoss": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "maxDD": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "maxDDpct": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "trades": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxWinStreak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxLossStreak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "winRate": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "profitFactor": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expectancy": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgWin": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgLoss": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgHoldBars": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1.7976931348623157e+308,
                      "maximum": 1.7976931348623157e+308
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "winRateReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "profitFactorReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "expectancyReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "avgWinReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "avgLossReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                },
                "avgHoldBarsReason": {
                  "enum": [
                    "no-trades",
                    "no-losses",
                    "no-winning-trades",
                    "no-nonwinning-trades"
                  ]
                }
              },
              "required": [
                "startEquity",
                "endEquity",
                "net",
                "returnPct",
                "worstLoss",
                "maxDD",
                "maxDDpct",
                "trades",
                "maxWinStreak",
                "maxLossStreak",
                "winRate",
                "profitFactor",
                "expectancy",
                "avgWin",
                "avgLoss",
                "avgHoldBars"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "winRate": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "winRateReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "winRateReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "profitFactor": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "profitFactorReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "profitFactorReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "expectancy": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "expectancyReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "expectancyReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "avgWin": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "avgWinReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "avgWinReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "avgLoss": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "avgLossReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "avgLossReason"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "avgHoldBars": {
                        "type": "null"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "avgHoldBarsReason"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "avgHoldBarsReason"
                      ]
                    }
                  }
                }
              ]
            },
            "tradeAccounting": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "entryFee": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  },
                  "exitFee": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  },
                  "netPnl": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  }
                },
                "required": [
                  "index",
                  "entryFee",
                  "exitFee",
                  "netPnl"
                ]
              }
            },
            "equity": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "t": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "equity": {
                    "type": "number",
                    "minimum": -1.7976931348623157e+308,
                    "maximum": 1.7976931348623157e+308
                  }
                },
                "required": [
                  "index",
                  "t",
                  "equity"
                ]
              }
            },
            "marked": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endEquity": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "net": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "returnPct": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "openUnrealizedPnl": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "openEntryFeePaid": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                }
              },
              "required": [
                "endEquity",
                "net",
                "returnPct",
                "openUnrealizedPnl",
                "openEntryFeePaid"
              ]
            }
          },
          "required": [
            "basis",
            "headline",
            "tradeAccounting",
            "equity",
            "marked"
          ]
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": {
              "enum": [
                "flat",
                "open"
              ]
            },
            "pendingOrderRejected": {
              "type": "boolean"
            },
            "openTrade": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "opportunityId": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "enum": [
                    "long",
                    "short"
                  ]
                },
                "entryIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "entryT": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "entry": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "size": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "stop": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "target": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "barsHeld": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "markPrice": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "unrealizedPnl": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                },
                "entryFeePaid": {
                  "type": "number",
                  "minimum": -1.7976931348623157e+308,
                  "maximum": 1.7976931348623157e+308
                }
              },
              "required": [
                "opportunityId",
                "side",
                "entryIndex",
                "entryT",
                "entry",
                "size",
                "stop",
                "target",
                "barsHeld",
                "markPrice",
                "unrealizedPnl",
                "entryFeePaid"
              ]
            }
          },
          "required": [
            "position",
            "pendingOrderRejected"
          ],
          "if": {
            "type": "object",
            "properties": {
              "position": {
                "const": "open"
              }
            },
            "required": [
              "position"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "openTrade"
            ]
          },
          "else": {
            "not": {
              "type": "object",
              "required": [
                "openTrade"
              ]
            }
          }
        },
        "capabilities": {
          "$ref": "sequential-backtest-result-v1.schema.json#/oneOf/0/properties/capabilities"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "closureCalendar": {
              "const": true
            },
            "undeclaredGaps": {
              "const": "refused"
            },
            "terminalOpenPosition": {
              "const": true
            },
            "maxBars": {
              "const": 500000
            }
          },
          "required": [
            "closureCalendar",
            "undeclaredGaps",
            "terminalOpenPosition",
            "maxBars"
          ]
        }
      },
      "required": [
        "schema",
        "contractVersion",
        "identity",
        "run",
        "metrics",
        "terminal",
        "capabilities",
        "limits"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "strat-sequential-market-result-v3"
        },
        "contractVersion": {
          "const": 3
        },
        "error": {
          "$ref": "sequential-backtest-result-v1.schema.json#/oneOf/1/properties/error"
        }
      },
      "required": [
        "schema",
        "contractVersion",
        "error"
      ]
    }
  ]
}
