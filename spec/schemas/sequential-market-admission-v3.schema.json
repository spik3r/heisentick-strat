          "required": [
            "closureCalendar",
            "undeclaredGaps",
            "terminalOpenPosition",
            "maxBars"
          ]
        },
        "runnable": {
          "const": true
        },
        "disposition": {
          "const": "runnable"
        }
      },
      "required": [
        "schema",
        "contractVersion",
        "runnable",
        "disposition",
        "route",
        "timeline",
        "limits"
      ]
