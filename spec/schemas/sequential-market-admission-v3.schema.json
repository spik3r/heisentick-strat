                    "type": "boolean"
                  },
                  "closureIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "index",
                  "previousOpenMs",
                  "openMs",
                  "deltaMs",
                  "onGrid",
                  "declared"
                ],
                "allOf": [
                  {
                    "if": {
                      "type": "object",
                      "properties": {
                        "onGrid": {
                          "const": true
                        }
                      },
                      "required": [
                        "onGrid"
                      ]
                    },
                    "then": {
                      "type": "object",
                      "required": [
                        "missingBars"
                      ]
                    },
                    "else": {
                      "not": {
                        "type": "object",
                        "required": [
                          "missingBars"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "type": "object",
                      "properties": {
                        "declared": {
                          "const": true
                        }
                      },
                      "required": [
                        "declared"
                      ]
                    },
                    "then": {
                      "type": "object",
                      "required": [
                        "closureIndex"
                      ]
                    },
                    "else": {
                      "not": {
                        "type": "object",
                        "required": [
                          "closureIndex"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "gapsTruncated": {
              "type": "boolean"
            }
          },
          "required": [
            "bars",
            "gapCount",
            "undeclaredGapCount",
            "gaps",
            "gapsTruncated"
          ]
        },
        "limits": {
