dsl v7
strategy "Session Scope V7 Session Window Run" {
  description "Run-conformance pin: a PDL sweep-and-reclaim at UTC hour 12 is outside the open-window london hours (UTC 06-09, local 16-19) under dsl v7 sessionWindow, so the trade is gated out and does not fire."
}

market conditions {
  slices(XAUUSD 1h)
  sessionWindow(london)
  day type in (ranging, choppy, trending)
  movement below 1.5
}

levels {
  priority(PDL)
}

filters {
  side long only
}

trigger {
  no confirmation candle
}

setup {
  type: named level sweep
}

entry {
  when price sweeps PDL and closes back above it then signal long
}

risk {
  stop below the signal candle and the level by 0 ATR
  stop size min 0 max 10
}

target {
  target 0.5R
}

execution {
  risk 200 USD
}
