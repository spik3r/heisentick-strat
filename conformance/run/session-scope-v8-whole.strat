dsl v8
strategy "Session Scope V8 Whole Run" {
  description "Run-conformance pin: a PDL sweep-and-reclaim at UTC hour 12 is inside the whole london session (08:00-16:00 UTC) under dsl v8 sessions, so the trade fires."
}

market conditions {
  slices(XAUUSD 1h)
  sessions(london)
  day type in (ranging, choppy, trending)
  movement below 1.5
}

levels {
  priority(PDL)
}

filters {
  side long only
}

trigger {
  no confirmation candle
}

setup {
  type: named level sweep
}

entry {
  when price sweeps PDL and closes back above it then signal long
}

risk {
  stop below the signal candle and the level by 0 ATR
  stop size min 0 max 10
}

target {
  target 0.5R
}

execution {
  risk 200 USD
}
