dsl v7
strategy "Close VWAP Extreme Magnet No NY Close" {
  description "Defensive 3+ ATR VWAP-extension fade excluding NY close segment; keeps the stable 2026 profile of the close-phase family while reducing the NY session tail risk."
}

market conditions {
  symbols(XAUUSD)
  timeframes(15m)
  sessions(london, ny)
  session phase in (open, middle, close)
  trade window in (london.close, ny.open, ny.middle)
  day type in (ranging, choppy) strictly
}

setup {
  type: vwap extension fade
  distance from vwap at least 3 ATR
  require range day
  target vwap
}

filters {
  tail rejection at least 0.35
  close location at least 0.55
}

risk {
  stop beyond last 5 candle extreme by 0.25 ATR
  stop size <= 2 ATR
}

target {
  target 1R
  minimum reward: 0.4R
}

management {
  move stop to breakeven after 0.25R plus 0.05 ATR
  maxHoldCandles 24
  wait 12 candles after trade
}

execution {
  risk: 200 USD
}
