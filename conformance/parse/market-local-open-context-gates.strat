dsl v7
strategy "Local and open-location market gates" {
  description "Parses fixed-UTC+10 weekday/hour allow and block lists plus open-location aliases."
}

market conditions {
  slices(XAUUSD 5m)
  local weekday in (Mon, Tue)
  weekday not in (Fri)
  local hour in (12, 13, 14, 15)
  hour not in (23)
  open location in (nearRangeMid, nearPDO, nearPDH, nearPDL, nearPDC)
}

setup {
  type: failed breakout
}

management {
  move stop to breakeven after 0.5R plus 0.05 ATR
  wait 12 candles after trade
}

filters {
  side both
}
