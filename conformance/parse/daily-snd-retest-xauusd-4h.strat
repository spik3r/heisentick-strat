dsl v7
strategy "Daily SND Retest XAUUSD 4h" {
  description "Prior-day level rejection on the 4h chart, with causal range/type filters and the original UTC session gate."
}

market conditions {
  slices(XAUUSD 4h)
  trade window UTC hours 8 to 21
  prior day type in (range, outside)
  prior day range at least 0.5 ATR
  movement below 1
}

levels {
  priority(PDL)
}

setup {
  type: named level sweep
}

entry {
  when price tests PDL within 0.35 ATR and closes above it then signal long
}

filters {
  side long only
}

triggers {
  candle in (pin, engulf, outside)
}

risk {
  stop below the signal candle and the level by 0.15 ATR
  stop size min 0.4 max 4.0
}

target {
  target 4.0R
}

management {
  move stop to breakeven after 0.75R plus 0.05 ATR
  wait 4 candles after trade
}

execution {
  risk 200 USD
}
